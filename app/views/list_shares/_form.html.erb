<turbo-frame id="share_form_<%= @todo_list.id %>">
    <div class="share-form">
      <p>Share this list with another user</p>
        <%= form_with(model: [todo_list, ListShare.new]) do |form| %>
        <%= form.collection_select :user_id, available_users, :id, :email,
          { prompt: "Select user" },
          { class: "form-control" } %>

        <%= form.select :permission_level,
          [["Read Only", "read"], ["Read & Write", "read_write"]],
          {}, { class: "form-control" } %>

        <%= form.submit "Share", class: "btn primary" %>
        <% end %>

        <% if todo_list.shared_users.any? %>
        <h4>Shared With:</h4>
        <ul>
            <% todo_list.list_shares.each do |share| %>
            <li>
                <%= share.user.email %> (<%= share.permission_level %>)
                <%= button_to "Remove", [todo_list, share], method: :delete, data: { turbo_stream: true }, class: "btn link" %>
            </li>
            <% end %>
        </ul>
        <% end %>
    </div>
</turbo-frame>